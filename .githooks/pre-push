#!/bin/sh
# BudgetMate pre-push hook — blocks DIRECT pushes to main.
#
# main is protected client-side (server-side branch protection needs a paid/public repo).
# All changes go through a feature branch + PR (see .claude/skills/feature-branch and
# CLAUDE.md "Git & CI workflow"). Enable once per clone:
#
#     git config core.hooksPath .githooks
#
# Git feeds "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin, one per ref
# being pushed. We reject if any target remote ref is refs/heads/main.

protected="refs/heads/main"
blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "$protected" ]; then
    blocked=1
  fi
done

if [ "$blocked" -eq 1 ]; then
  echo "✖ pre-push: direct pushes to 'main' are blocked." >&2
  echo "  Open a PR from a feature branch instead:" >&2
  echo "    git switch -c feat/<issue>-<slug>   # see the feature-branch skill" >&2
  echo "    git push -u origin <branch> && gh pr create" >&2
  echo "  (Override for a one-off, discouraged: git push --no-verify)" >&2
  exit 1
fi

exit 0
